# Komodo image tag — must match the Core version
KOMODO_IMAGE_TAG=2

# Timezone
TZ=Asia/Ho_Chi_Minh

# -------------------------
# Komodo Periphery
# -------------------------
# Full reference: https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml

# Address of the Komodo Core instance
PERIPHERY_CORE_ADDRESS=ws://<CORE_HOST_IP>:9120

# Name this server will appear as in the Komodo UI
PERIPHERY_CONNECT_AS=my-server-name

# Paste the Core's public key here after first launching Core.
# Found in Core UI under Settings > Authentication > Core Public Key.
PERIPHERY_CORE_PUBLIC_KEYS=<PASTE_CORE_PUBLIC_KEY>

# Root directory for stacks/repos managed by this Periphery agent
# Must be the same path inside and outside the container
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

# Whitelist the primary disk mount to avoid overreporting disk size
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
