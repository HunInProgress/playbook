# Komodo image tag — follows major.minor.patch semver, or use "2" for latest v2
KOMODO_IMAGE_TAG=2

# Paths on host for persistent data
KOMODO_MONGO_DATA=/etc/komodo/mongo/data
KOMODO_MONGO_CONFIG=/etc/komodo/mongo/config
KOMODO_KEYS_PATH=/etc/komodo/keys
KOMODO_BACKUPS_PATH=/etc/komodo/backups

# MongoDB credentials
KOMODO_DATABASE_USERNAME=admin
KOMODO_DATABASE_PASSWORD=changeme

# Timezone for schedules — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Ho_Chi_Minh

# -------------------------
# Komodo Core
# -------------------------
# Full reference: https://github.com/moghtech/komodo/blob/main/config/core.config.toml

# Public URL where Komodo Core is reachable (used for OAuth callbacks and webhook URL suggestions)
KOMODO_HOST=http://localhost:9120

# Tab title in the browser
KOMODO_TITLE=Komodo

# Allow Periphery agents to authenticate via generated public key
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

# Local username/password login
KOMODO_LOCAL_AUTH=true

# Initial admin credentials (only used on first launch)
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=changeme

# Name of the first server entry created automatically (should match PERIPHERY_CONNECT_AS)
KOMODO_FIRST_SERVER_NAME=Local

# Secrets — change these to random values
KOMODO_WEBHOOK_SECRET=change_me_random_secret
KOMODO_JWT_SECRET=change_me_random_jwt_secret

# JWT token TTL — options: 1-hr, 12-hr, 1-day, 3-day, 1-wk, 2-wk
KOMODO_JWT_TTL=1-day

# How often to poll servers for status/stats/alerts — options: 1-sec, 5-sec, 15-sec, 1-min, 5-min, 15-min
KOMODO_MONITORING_INTERVAL=15-sec

# -------------------------
# Komodo Periphery (local)
# -------------------------
# Full reference: https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml

# Address of the Core container (use service name when running in same compose)
PERIPHERY_CORE_ADDRESS=ws://core:9120

# Must match KOMODO_FIRST_SERVER_NAME
PERIPHERY_CONNECT_AS=Local

# Authenticate using Core's generated public key
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

# Root directory for stacks/repos managed by this Periphery agent
# Must be the same path inside and outside the container
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

# Whitelist the primary disk mount to avoid overreporting disk size
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
