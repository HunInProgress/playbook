# Timezone — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Ho_Chi_Minh

# Linux user/group ID for file permissions
PUID=1000
PGID=1000

# Public URL for Jellyfin when behind a reverse proxy (optional)
# e.g. https://jellyfin.home.example.com
JELLYFIN_HOST=

# --- Volume paths ---
JELLYFIN_CONFIG=/mnt/rust/jellyfin/config
JELLYFIN_CACHE=/mnt/rust/jellyfin/cache
MEDIA_PATH=/mnt/media
