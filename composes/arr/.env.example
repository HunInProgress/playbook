# Timezone — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Ho_Chi_Minh

# Linux user/group ID for file permissions
PUID=1000
PGID=1000

# Base domain for Traefik routing (e.g. home.example.com)
# Services will be exposed as prowl.<ARR_HOST>, son.<ARR_HOST>, etc.
ARR_HOST=

# --- Volume paths ---
# Config directories
PROWLARR_CONFIG=/mnt/rust/prowlarr
SONARR_CONFIG=/mnt/rust/sonarr
RADARR_CONFIG=/mnt/rust/radarr
LIDARR_CONFIG=/mnt/rust/lidarr
BAZARR_CONFIG=/mnt/rust/bazarr
QBITTORRENT_CONFIG=/mnt/rust/qbittorrent

# Media libraries
TV_PATH=/mnt/media/tv
MOVIES_PATH=/mnt/media/movies
MUSIC_PATH=/mnt/media/music

# Shared downloads directory
DOWNLOADS_PATH=/mnt/rust/downloads
