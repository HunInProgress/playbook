# Immich version tag — use "release" to always pull the latest stable release
IMMICH_VERSION=release

# Path on the host to store uploaded photos/videos
UPLOAD_LOCATION=/mnt/media/immich

# Path on the host to cache ML models
MODELS_CACHE_LOCATION=/mnt/mp0/immich/models

# Path on the host for the PostgreSQL data directory
DB_DATA_LOCATION=/mnt/mp0/immich/db

# PostgreSQL credentials
DB_USERNAME=immich
DB_PASSWORD=
DB_DATABASE_NAME=immich
